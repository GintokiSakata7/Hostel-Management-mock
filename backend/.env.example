# Neon PostgreSQL Connection URLs
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.us-east-2.aws.neon.tech/neondb?sslmode=require"

PORT=3001

# Fee Reminder Scheduler Configuration
REMINDER_CRON_SCHEDULE="0 19 * * *" # Daily at 19:00 (7 PM IST)
REMINDER_TIMEZONE="Asia/Kolkata"

# Telegram Credentials
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"
TELEGRAM_API_ID="YOUR_TELEGRAM_API_ID"
TELEGRAM_API_HASH="YOUR_TELEGRAM_API_HASH"
TELEGRAM_SESSION="YOUR_TELEGRAM_SESSION"

# Official Meta WhatsApp Cloud API (1,000 FREE Messages/Month, 100% Ban-Safe)
META_WHATSAPP_TOKEN="YOUR_META_WHATSAPP_PERMANENT_ACCESS_TOKEN"
META_WHATSAPP_PHONE_ID="YOUR_META_WHATSAPP_PHONE_NUMBER_ID"

# Twilio Credentials (Optional Fallback)
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="+18005550199"
